# ============================================
# Virtualpet Server 环境变量模板
# 复制此文件为 .env，填入真实值后启动
#   cp .env.example .env
# ============================================

# 数据库密码
POSTGRES_PASSWORD=修改为你的数据库密码

# JWT 签名密钥 (生成方式: openssl rand -hex 32)
SECRET_KEY=修改为随机64字符密钥

# DashScope 音色ID (阿里云 TTS 自定义音色)
DASHSCOPE_VOICE_ID=你的音色ID

# 日志级别 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO
