/**
 * @file hw_secrets.h.in
 * @brief 现场 WiFi 凭据模板 — run.py 会生成 main/hw_secrets.h (gitignored)
 *
 * 这个文件里**不要**填真实密码: 只作模板入库。要连网跑校验就用
 *   python tools/hwtest/run.py --ssid <SSID> --wifi-pass-file <密码文件>
 * 密码只从文件读, 不进命令行/进程列表 (凭据纪律)。
 */
#ifndef HW_SECRETS_H
#define HW_SECRETS_H

#define HWTEST_WIFI_SSID ""   /* 非空 = 连接校验 */
#define HWTEST_WIFI_PASS ""
#define HWTEST_SKIP_WIFI 0    /* 1 = 整段 WiFi 不跑 (直接 SKIP) */
#define HWTEST_ALLOW_NO_WIFI 0 /* 1 = 扫不到 AP 记 SKIP 而不是 FAIL (屏蔽房/暗室) */

#endif /* HW_SECRETS_H */
