# Virtualpet sdkconfig defaults
# Target
CONFIG_IDF_TARGET_ESP32S3=y

# PSRAM (Octal 8MB)
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# CPU
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# Compiler: optimize for size (-Os) to avoid GCC 14.2.0 ICE in esp_lcd RGB
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# SPI Flash
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# LVGL
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_16_SWAP=y
# 内存池走 PSRAM (custom malloc, 实现在 main/lvgl_mem.c) —
# 默认 BUILTIN_MALLOC 的 64KB 静态池占内部 SRAM, 迁出后 SRAM 空闲翻倍
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_BUILTIN_MALLOC=n
CONFIG_LV_HOR_RES_MAX=240
CONFIG_LV_VER_RES_MAX=240
CONFIG_LV_MEM_SIZE=256
CONFIG_LV_DISP_BUFFER_SIZE=115200
CONFIG_LV_USE_DRAW_SW=y
CONFIG_LV_USE_DRAW_SW_ASM=y
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_SPRINTF_USE_FLOAT=n
# 状态栏/气泡等组件引用的英文字体字号
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
# 中文字体 2.7MB 字形超 1MB — bitmap_index 默认 20 位会溢出回绕 → 乱码, 必须开
CONFIG_LV_FONT_FMT_TXT_LARGE=y

# SPI display driver
CONFIG_LV_USE_ST7789=y
CONFIG_LV_TFT_DISPLAY_SPI2_HOST=y
CONFIG_LV_TFT_DISPLAY_SPI_HSPI_MODE=n
CONFIG_LV_TFT_DISPLAY_SPI_FULL_DUPLEX=n
CONFIG_LV_TFT_DISPLAY_SPI_TRANS_PREFIX_EXDATA=y

# LVGL FS — STDIO 驱动映射 assets (字体文件加载)
CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=83
CONFIG_LV_FS_STDIO_PATH="/assets/"
CONFIG_LV_FS_STDIO_CACHE_SIZE=4096

# LVGL MEMFS — 内存缓冲区字体 (避免 SPIFFS 逐字节 seek)
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77

# WiFi — 2026-08-23 内部堆健康化 (v1.0.246 24→16, v1.0.249 16→8): 削减收发缓冲池
# 内部堆 boot 105KB → ~57s 枯竭 (wifi 驱动 50-70KB + 缓冲池常驻/峰值),
# 导致 WS 任务创建失败 / ASR socket OOM / lwIP 信号量 OOM / fopen abort (locks.c:77)
# / newlib 锁分配 abort (1.0.248 实崩: 任务首次 printf 时锁 lazy 分配需内部堆)。
# 本项目负载 (TTS ~64kbps + HTTP 小请求) 远低于 WiFi 极限, 减池无感。
# 1.0.249: 动态 rx/tx 16→8 再回收 ~25KB — 目标是内部堆保持 >8KB 连续块,
# esp_flash 读的 8KB 内部 DMA 缓冲可分配 (否则动画帧读 0x101 失败, 首帧卡)。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=DYNAMIC
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

# LWIP — 同上: 本项目同时 ≤8 socket (WS 1 + HTTP 2-3), 窗口 32KB 对流媒体足够
CONFIG_ESP_HTTP_CLIENT_EVENT_HANDLER=y
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_LWIP_TCP_MSS=1440
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32

# PSRAM 任务栈 (TTS/会话任务栈放外部 RAM, 防内部 RAM 碎片化)
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# mbedTLS
# 2026-08-23 (v1.0.247): 全部 TLS 上下文挪 PSRAM — WS 长连接常驻
# ~40KB mbedTLS 缓冲 (IN/OUT 16KB×2 + ctx) 此前吃内部堆, 1.0.246 健康化
# 省的 30-40KB 被它抵消 (67s 内部堆仍 1KB); EXTERNAL_MEM_ALLOC 后
# 握手缓冲走 PSRAM, 内部堆省 ~40KB, 性能影响无感 (本项目负载低)
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=16384
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# Touch (legacy API)
CONFIG_TOUCH_SUPPRESS_LEGACY_WARNING=y

# I2S
CONFIG_I2S_ISR_IRAM_SAFE=y

# SPI
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

# OTA
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y

# LVGL v8 配置在 lv_conf.h 中

# Console / logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# FAT Filesystem
CONFIG_WL_SECTOR_SIZE=4096
# TinyUSB MSC (U盘模式): 逻辑扇区 4096 与 WL 对齐, FIFO 必须 ≥ 扇区大小
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096
# 长文件名必须开 — LFN_NONE 只支持 8.3 格式 (扩展名最长 3 字符),
# "wifi.json"/"pet.json" 的 4 字符扩展名会被 FR_INVALID_NAME 拒绝 (errno=22)
CONFIG_FATFS_LFN_HEAP=y
# 关 per-file 缓存 (_FS_TINY=1): FIL 不再内嵌 4KB 扇区缓冲 —
# esp_vfs_fat_register_cfg 一次 ctx 分配从 ~39KB (8 文件 × 4.2KB) 降到 ~6KB,
# 运行数小时后堆碎片化时格式化不再因 ESP_ERR_NO_MEM 失败 (1.0.217)
# CONFIG_FATFS_PER_FILE_CACHE is not set

# SPIFFS (page_size=1024 for 27MB partition; 256 only addresses 16MB)
CONFIG_SPIFFS_CACHE=y
CONFIG_SPIFFS_CACHE_WR=y
CONFIG_SPIFFS_PAGE_SIZE=1024
CONFIG_SPIFFS_USE_MTIME=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# 主任务跑 esp_http_client 天气请求 + cJSON, 默认 3584 栈实测仅余 312B;
# 6144 曾不够: f_mkfs 建卷路径 (SPIFFS 挂载后自动建 FAT) 栈溢出重启循环
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Power management — 轻睡眠 (v1, 2026-08-22):
# esp_pm_configure 在 power_manager_init 运行时使能 (v5.5 默认 light_sleep=false)
CONFIG_PM_ENABLE=y
CONFIG_PM_SLP_IRAM_OPT=y              # 轻睡代码入 IRAM, 每次入睡省 ~310µs
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y     # 进出轻睡日志 (调试期, 稳定后可关)
# USB Serial/JTAG 连接时持 NO_LIGHT_SLEEP 锁禁睡 (v2, 2026-08-22):
# S3 硬件限制: USJ 在 light sleep 下无法工作 (Kconfig 帮助明示) — 轻睡开时插 USB
# 必断枚举 (v2.2/2.3/2.4 三次复现, 与 WiFi 无关)。连接监视器 40ms 无 SOF 判断开
# 后释放锁 → 拔 USB 后轻睡恢复可用 = 平时电池省电, 插 USB 调试稳定。
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

# NTP 校时 (time_manager): 双服务器 + 60s 重试 (默认 1h 首轮失败等太久)
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_LWIP_SNTP_UPDATE_DELAY=60000

# 事件循环任务栈 2304→4096: GOT_IP 处理链 (lwip/netif + LittleFS 写盘) 曾越界砸坏相邻堆块 (1.0.204 间歇 panic)
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# U盘卷标 (f_setlabel — Windows 磁盘名显示)
CONFIG_FATFS_USE_LABEL=y

# 中断看门狗 300→1000→2000ms: 聊天回复路径存在 >1000ms 关中断窗口 (INTWDT 曾误杀重启; 定位中)
CONFIG_ESP_INT_WDT_TIMEOUT_MS=2000
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_LV_USE_LIBWEBP=y

# v2.8 诊断: vTaskList 任务延迟探针 (定位轻睡被谁霸占; 稳定后移除)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# 1.0.265: WS send 独立 tx_lock — 播放期大音频帧 recv 持 client->lock 等 payload,
# 敲击事件 send (同锁) 撞锁丢事件 (实测 "Could not lock within 100 timeout" 刷屏)
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
